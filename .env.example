# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ─────────────────────────────────────────────────────────────────
# IMPORTANT: replicaSet=rs0 is required — transactions will not work without it.
# Run the replica-set setup in README.md before starting the backend.
MONGO_URI=mongodb://127.0.0.1:27018/eventhive?replicaSet=rs0

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_CHAR_HEX_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ─── Booking ──────────────────────────────────────────────────────────────────
HOLD_EXPIRY_MINUTES=15
PAYMENT_TIMEOUT_MINUTES=30

# ─── Payment (sandbox until real credentials supplied) ────────────────────────
PAYMENT_PROVIDER=sandbox
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
