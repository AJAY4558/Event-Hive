# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ─────────────────────────────────────────────────────────────────
# Development and production app processes must use Atlas. Replace these
# placeholders and keep the real URI only in the ignored backend/.env file.
# Integration tests override this with their isolated eventhive_test database.
MONGO_URI=mongodb+srv://<db_user>:<url_encoded_password>@<cluster-host>/eventhive?retryWrites=true&w=majority&appName=EventHive

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_CHAR_HEX_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
UPLOAD_STORAGE_DRIVER=atlas
# The API serves uploaded files from Atlas. Tests override this to local storage.
# Set this only when the API is behind a custom public URL or reverse proxy.
# UPLOAD_PUBLIC_BASE_URL=https://api.example.com

# ─── Booking ──────────────────────────────────────────────────────────────────
HOLD_EXPIRY_MINUTES=15
PAYMENT_TIMEOUT_MINUTES=30

# ─── Payment (sandbox until real credentials supplied) ────────────────────────
PAYMENT_PROVIDER=sandbox
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
