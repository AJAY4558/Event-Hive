# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ─────────────────────────────────────────────────────────────────
# MONGO_URI must target a replica set for transaction support.
# Local standard URIs include replicaSet=rs0; Atlas SRV URIs discover members automatically.
MONGO_URI=mongodb://127.0.0.1:27018/eventhive?replicaSet=rs0
# Atlas example (replace placeholders; keep credentials only in backend/.env):
# MONGO_URI=mongodb+srv://<db_user>:<url_encoded_password>@<cluster-host>/eventhive?retryWrites=true&w=majority&appName=EventHive

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_CHAR_HEX_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
UPLOAD_STORAGE_DRIVER=local
# Optional when the frontend and local API use different origins (for example, a Vite production preview).
# UPLOAD_PUBLIC_BASE_URL=http://localhost:4000
# Production uploads require a persistent S3-compatible object store. Do not use local disk for production uploads.
# UPLOAD_STORAGE_DRIVER=s3
# UPLOAD_PUBLIC_BASE_URL=https://cdn.example.com/eventhive
# UPLOAD_S3_BUCKET=your-eventhive-image-bucket
# UPLOAD_S3_REGION=your-bucket-region
# UPLOAD_S3_ENDPOINT=https://s3-compatible-storage.example.com
# UPLOAD_S3_ACCESS_KEY_ID=
# UPLOAD_S3_SECRET_ACCESS_KEY=

# ─── Booking ──────────────────────────────────────────────────────────────────
HOLD_EXPIRY_MINUTES=15
PAYMENT_TIMEOUT_MINUTES=30

# ─── Payment (sandbox until real credentials supplied) ────────────────────────
PAYMENT_PROVIDER=sandbox
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
